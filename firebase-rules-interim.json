{
  // INTERIM HARDENING — paste-ready. Nothing in the app or the iPhone
  // Shortcuts breaks, because nothing here requires authentication.
  //
  // Validated 2026-08-11 against the live database:
  //   profiles      {"chinmay":"Chinmay"}          string, passes
  //   users         object with children            passes
  //   external/*    all values numeric, all >= 0    passes
  //   foodBank      32 entries, all have name +
  //                 calories, zero unexpected keys  passes
  //   "Start fresh" writes a starter object rather
  //                 than deleting                   still works
  //
  // STOPS: wholesale deletion (every write must leave data behind, so a
  // DELETE, a null write or a {} overwrite is refused), destruction of the
  // frozen pre-profiles backup at /lifestack, junk in the shared food bank,
  // and garbage dates or non-numeric values in the health node.
  //
  // DOES NOT STOP: reading. The database URL is in a public repo, so anyone
  // who finds it can still read everything. Only real auth fixes that — see
  // firebase-rules.json, which needs Firebase Auth added to the app first.
  //
  // This is a seatbelt, not a lock.
  "rules": {
    ".read": false,
    ".write": false,

    "profiles": {
      ".read": true,
      "$profileId": {
        ".write": "newData.exists()",
        ".validate": "newData.isString() && newData.val().length <= 60"
      }
    },

    "users": {
      "$profileId": {
        ".read": true,
        ".write": "newData.exists()",
        ".validate": "newData.hasChildren()"
      }
    },

    "external": {
      ".read": true,

      // Named children are matched before $metric, so these two escape the
      // numeric validation below — workouts are objects, not numbers.
      "u": {
        "$profileId": {
          ".read": true,
          ".write": "newData.exists()"
        }
      },
      "workouts": {
        "$date": { ".write": "newData.exists()" }
      },

      // When the Shortcut last finished a full run. A single value at the
      // METRIC level, not metric/date like the readings, so it needs its own
      // rule — $metric below only ever matches a $date child, which would
      // have left this write denied by the root ".write": false.
      "lastSync": {
        ".write": "newData.exists()",
        ".validate": "newData.isNumber() || (newData.isString() && newData.val().length <= 64)"
      },

      "$metric": {
        "$date": {
          ".write": "newData.exists()",
          ".validate": "newData.isNumber() && newData.val() >= 0 && $date.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
        }
      }
    },

    "foodBank": {
      ".read": true,
      "$foodKey": {
        ".write": "newData.exists()",
        ".validate": "newData.hasChildren(['name', 'calories'])",
        "name":     { ".validate": "newData.isString() && newData.val().length <= 120" },
        "calories": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000" },
        "protein":  { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "carbs":    { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "fat":      { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "fiber":    { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "$other":   { ".validate": false }
      }
    },

    // Public intake for testers (report.html). Write-only and CREATE-only:
    // !data.exists() means a submission can be made but never edited or
    // deleted, and ".read": false means a tester cannot read anyone else's
    // report. Reads are OPEN because the app has no authentication, so there is
    // no way to let only the owner read. Bug reports and app screenshots are the
    // least sensitive thing in this database, and users/<id> is already readable;
    // the create-only WRITE rule is what still matters - nobody can edit or
    // delete a filed report, including the person who filed it.
    //
    // Screenshots ride along as base64. They live HERE rather than under
    // users/<id> because the app subscribes to that whole node with .on(),
    // so images there would be re-downloaded on every sync.
    "inbox": {
      // Open: with no auth there is no way to admit only the owner.
      ".read": true,
      "$reportId": {
        // Create OR delete, never edit. The middle case is the one that matters:
        // a filed report cannot be reworded by anyone, including whoever sent it.
        // Delete has to be allowed or the inbox is immortal - the app subscribes
        // to this whole node, so undeletable screenshots would be re-read on
        // every launch forever. With no auth there is no way to allow deletion
        // for the owner alone, which is the same trade already made everywhere
        // else in this database.
        ".write": "(!data.exists() && newData.exists()) || !newData.exists()",
        ".validate": "newData.hasChildren(['title', 'at'])",
        "title":   { ".validate": "newData.isString() && newData.val().length <= 200" },
        "detail":  { ".validate": "newData.isString() && newData.val().length <= 4000" },
        "who":     { ".validate": "newData.isString() && newData.val().length <= 60" },
        "project": { ".validate": "newData.isString() && newData.val().length <= 40" },
        // The create-only rule above freezes a report FOREVER, which is right for
        // its content but wrong for its workflow state: the app has to be able to
        // mark one accepted or dismissed. A child .write grants where the parent
        // withholds, so status - and only status - stays writable. Title, detail
        // and screenshots remain unalterable once filed.
        "status":  { ".write": true,
                     ".validate": "newData.isString() && newData.val().length <= 20" },
        "at":      { ".validate": "newData.isNumber()" },
        // Three screenshots at roughly 150KB each once base64-encoded.
        "shots": {
          "$i": { ".validate": "newData.isString() && newData.val().length <= 900000" }
        },
        "$other": { ".validate": false }
      }
    },

    "lifestack": {
      ".read": true,
      ".write": false
    }
  }
}
